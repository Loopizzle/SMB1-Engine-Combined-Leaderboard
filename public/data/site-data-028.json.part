Flag":"#REF!","Country":"United States","Total Score":6239.7,"Performance Score":6145.7,"Runs":36,"Volume Bonus":48,"Variety Bonus":10,"Unique Boards":12,"Unique Games":2,"Profile":"https://www.speedrun.com/users/yelia64"},{"Year":2024,"Winner":"sullyrox","Flag":"#REF!","Country":"United States","Total Score":7594.91,"Performance Score":7469.45,"Runs":43,"Volume Bonus":52.46,"Variety Bonus":30,"Unique Boards":12,"Unique Games":4,"Profile":"https://www.speedrun.com/users/sullyrox"},{"Year":2025,"Winner":"Littlezombie","Flag":"#REF!","Country":"China","Total Score":13095.4,"Performance Score":12910.96,"Runs":82,"Volume Bonus":72.44,"Variety Bonus":30,"Unique Boards":20,"Unique Games":4,"Profile":"https://www.speedrun.com/users/Littlezombie"},{"Year":2026,"Winner":"stem_kuki","Flag":"#REF!","Country":"New Zealand","Total Score":3915.8,"Performance Score":3853.85,"Runs":18,"Volume Bonus":33.94,"Variety Bonus":10,"Unique Boards":7,"Unique Games":2,"Profile":"https://www.speedrun.com/users/stem_kuki"}],"about":[{"Field":"Project","Details":"SMB1 Engine Combined Leaderboard"},{"Field":"Purpose","Details":"A community-oriented leaderboard combining current non-obsolete Speedrun.com runs across configured SMB1-engine boards."},{"Field":"Primary Ranking","Details":"Total Score combines placement performance, a diminishing-returns volume bonus, and a cross-game variety bonus."},{"Field":"Volume Bonus","Details":"Rewards the number of current included leaderboard entries with diminishing returns."},{"Field":"Variety Bonus","Details":"Awards 10 points for each additional included game after the first; unique boards are not counted again here."},{"Field":"Luigi Toggles","Details":"The Games sheet includes separate Luigi rows for ANN SMB, The Lost Levels, and The Lost Levels CE."},{"Field":"Live Filtering","Details":"Games and Boards checkboxes recalculate Combined Leaderboard and Players live. Apps Script refreshes raw Speedrun.com data; sheet formulas calculate the public scores."},{"Field":"Data Source","Details":"Speedrun.com public API"},{"Field":"Default Games","Details":"smb1, smbce, smbtll, smbtllce, annsmb, vssmb"},{"Field":"Inspiration","Details":"Inspired by aaron2u2's NES prolific speedrunner leaderboard project."},{"Field":"Credit Note","Details":"This sheet is independently made and is not intended as a replacement for, or endorsement by, Aaron's project."},{"Field":"Monthly View","Details":"Monthly View and Monthly Winners use verified runs from monthly_start_month onward, including runs that later became obsolete. Monthly ranks use a performance-weighted total score."},{"Field":"Yearly View","Details":"Yearly View and Yearly Winners group verified runs by the manually entered run date. Verification date is used only when a run has no entered date. Yearly performance is recalculated for the year rather than added from monthly totals."},{"Field":"Runner Profile","Details":"Select a runner to see their live score summary, game breakdown, strongest contributing runs, and yearly history."},{"Field":"Score Audit","Details":"Select a runner to reconcile Total Score to Performance Score, Volume Bonus, and Variety Bonus and inspect every included contributing run."},{"Field":"Head-to-Head","Details":"Select two runners to compare scores, game activity, shared boards, and boards unique to either runner. Interactive controls work in editable copies."}]}